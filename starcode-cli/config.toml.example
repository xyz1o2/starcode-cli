# StarCode CLI 配置文件示例
# Configuration file example for StarCode CLI
# 复制此文件为 config.toml 并填入您的配置

[api]
# 当前激活的 Provider (openai, deepseek, anthropic, google, ollama, lmstudio, moonshot, doubao, qwen)
provider = "deepseek"

# 默认模型
model = "deepseek-chat"

# 温度参数 (0.0-2.0)
temperature = 0.7

# 最大输出 Token
max_tokens = 8192

# OpenAI 兼容模式 (设为 true 可防止因模型名称关键字强制切换 Provider)
openai_compatible = false

# -----------------------------------------------------------------------------
# Provider 配置 (取消注释并填入您的 API Key)
# -----------------------------------------------------------------------------

