# Runtime data
target/

# Cargo.lock is deliberately NOT ignored — this is a binary crate, so the exact
# resolved dependency versions must be committed. Release builds use `--locked`,
# which fails outright without a committed lockfile.
!Cargo.lock

# Environment variable file
.env

# Configuration directories


# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Scratch/throwaway test files.
# Anchored to the repo root on purpose: the `**/` form used to match
# tests/core/test_*.rs, and tests/core/mod.rs declares those as modules — so a
# fresh clone could not compile the `tests/lib.rs` integration target.
# Integration tests under tests/ are real and must stay tracked.
/test_*.rs
/temp_*.rs
study_or_copy_projects/
.spec-workflow/
.star/
.freebuff/

# Tool data (agent session memory/logs)
.workbuddy/
